# Cabeceras de seguridad de la landing (hotelherencia.cl, Apache estático).
# La política vive en hosting/csp.txt y la prueba landing/test/csp.test.mjs exige que este archivo la repita igual.
# Si el hosting ya envía otra Content-Security-Policy, esta la reemplaza (Header always set).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://www.gstatic.com https://www.google.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; frame-src https://www.google.com https://recaptcha.google.com; connect-src 'self' https://www.google.com https://plataforma-salman-herencia-oficial.vercel.app"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
