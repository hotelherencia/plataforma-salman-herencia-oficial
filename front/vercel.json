{
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api", "destination": "https://servicio-production-a2d7.up.railway.app/" },
    { "source": "/api/:path*", "destination": "https://servicio-production-a2d7.up.railway.app/:path*" }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
